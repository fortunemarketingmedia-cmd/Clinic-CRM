limit_req_zone $binary_remote_addr zone=revive_api:10m rate=20r/s;

server {
    listen 80;
    server_name crm.reviveskinclinics.in api.crm.reviveskinclinics.in;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name crm.reviveskinclinics.in;

    ssl_certificate /etc/letsencrypt/live/crm.reviveskinclinics.in/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/crm.reviveskinclinics.in/privkey.pem;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    gzip on;
    gzip_comp_level 5;
    gzip_types text/plain text/css application/json application/javascript image/svg+xml;

    location /_next/static/ {
        proxy_pass http://127.0.0.1:3100;
        proxy_http_version 1.1;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location / {
        proxy_pass http://127.0.0.1:3100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 443 ssl http2;
    server_name api.crm.reviveskinclinics.in;
    client_max_body_size 12m;

    ssl_certificate /etc/letsencrypt/live/api.crm.reviveskinclinics.in/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.crm.reviveskinclinics.in/privkey.pem;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    gzip on;
    gzip_comp_level 5;
    gzip_types application/json text/plain;

    location / {
        limit_req zone=revive_api burst=80 nodelay;
        proxy_pass http://127.0.0.1:4100;
        proxy_http_version 1.1;
        proxy_connect_timeout 10s;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
    }
}
