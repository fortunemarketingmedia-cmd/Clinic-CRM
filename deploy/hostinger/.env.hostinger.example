# Copy to .env.hostinger on the VPS, replace every placeholder, then chmod 600.
# Keep values shell-safe. URL-encode any special characters used inside DATABASE_URL.
COMPOSE_PROJECT_NAME=revive-crm
CRM_DOMAIN=crm.reviveskinclinics.in
API_DOMAIN=api.crm.reviveskinclinics.in
TLS_EMAIL=admin@reviveskinclinics.in
NEXT_PUBLIC_API_URL=https://api.crm.reviveskinclinics.in/api
BACKUP_HOST_PATH=/srv/revive-crm/backups
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
MIN_BACKUP_FREE_KIB=10485760
RESTIC_KEEP_DAILY=14
RESTIC_KEEP_WEEKLY=8
RESTIC_KEEP_MONTHLY=12
OFFSITE_BACKUP_INTERVAL_SECONDS=86400
# Use a pinned-host-key SFTP repository independent of the VPS.
LOCAL_BACKUP_PASSWORD=replace-with-a-unique-local-restic-repository-password
OFFSITE_SSH_DIR=/etc/revive-crm/offsite-ssh
RESTIC_REPOSITORY=
RESTIC_PASSWORD=

NODE_ENV=production
PORT=4000
TRUST_PROXY_HOPS=1
POSTGRES_DB=revive_crm
POSTGRES_USER=revive_app
POSTGRES_PASSWORD=replace-with-a-unique-url-safe-database-password
DATABASE_URL=postgresql://revive_runtime:replace-with-a-unique-runtime-database-password@postgres:5432/revive_crm?schema=public&connection_limit=15&pool_timeout=10
# Supply the schema-owner DSN here when using a restricted runtime database role.
DB_RUNTIME_PASSWORD=replace-with-a-unique-runtime-database-password
MIGRATION_DATABASE_URL=postgresql://revive_app:replace-with-a-unique-url-safe-database-password@postgres:5432/revive_crm?schema=public
REDIS_PASSWORD=replace-with-a-unique-url-safe-redis-password
REDIS_URL=redis://:replace-with-a-unique-url-safe-redis-password@redis:6379
REDIS_KEY_PREFIX=revive:

FILE_STORAGE_PROVIDER=local
FILE_STORAGE_ROOT=/private-files
FILE_ENCRYPTION_KEY=replace-with-base64-output-of-openssl-rand-base64-32
MAX_UPLOAD_BYTES=10485760
MAX_IMAGE_PIXELS=64000000

JWT_ACCESS_SECRET=replace-with-independent-output-of-openssl-rand-base64-48
JWT_REFRESH_SECRET=replace-with-independent-output-of-openssl-rand-base64-48
INTEGRATION_ENCRYPTION_KEY=replace-with-independent-output-of-openssl-rand-base64-32
FILE_ACCESS_SECRET=replace-with-independent-output-of-openssl-rand-base64-48
GOOGLE_ADS_INGEST_SECRET=replace-with-independent-output-of-openssl-rand-base64-48
META_ADS_INGEST_SECRET=replace-with-independent-output-of-openssl-rand-base64-48
WEBSITE_LEAD_INGEST_SECRET=replace-with-independent-output-of-openssl-rand-base64-48
METRICS_SECRET=replace-with-independent-output-of-openssl-rand-base64-48
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
FILE_SCAN_REQUIRED=true
PAYMENT_GATEWAY_ENABLED=false
EMAIL_ENABLED=false
WHATSAPP_ENABLED=false
PAYMENT_GATEWAY_SECRET=

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
REFRESH_TOKEN_DAYS=7
REFRESH_TOKEN_COOKIE_NAME=revive_refresh_token
COOKIE_DOMAIN=
FRONTEND_URL=https://crm.reviveskinclinics.in
FRONTEND_URLS=https://crm.reviveskinclinics.in
BACKEND_PUBLIC_URL=https://api.crm.reviveskinclinics.in

META_GRAPH_API_URL=https://graph.facebook.com
META_GRAPH_API_VERSION=v23.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APPOINTMENT_TEMPLATE_NAME=appointment_confirmation
WHATSAPP_APPOINTMENT_TEMPLATE_LANGUAGE=en_US

GOOGLE_ADS_API_URL=https://googleads.googleapis.com
GOOGLE_ADS_API_VERSION=v20
GOOGLE_OAUTH_TOKEN_URL=https://oauth2.googleapis.com/token
GOOGLE_OAUTH_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
INTEGRATION_JOB_POLL_MS=10000
INTEGRATION_WORKER_ID=revive-integration-worker
PROVIDER_REQUEST_TIMEOUT_MS=20000
SHUTDOWN_TIMEOUT_MS=10000
MFA_ISSUER=Revive Clinic CRM

# Outgoing email (finance report export, etc.) - leave blank to disable email sending
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
