# Copy to .env.hostinger on the VPS, replace every placeholder, then chmod 600.
# Keep values shell-safe. URL-encode any special characters used inside DATABASE_URL.
COMPOSE_PROJECT_NAME=revive-crm
CRM_DOMAIN=crm.reviveskinclinics.in
API_DOMAIN=api.crm.reviveskinclinics.in
TLS_EMAIL=admin@reviveskinclinics.in
NEXT_PUBLIC_API_URL=https://api.crm.reviveskinclinics.in/api
BACKUP_HOST_PATH=/srv/revive-crm/backups
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14

NODE_ENV=production
PORT=4000
TRUST_PROXY_HOPS=1
POSTGRES_DB=revive_crm
POSTGRES_USER=revive_app
POSTGRES_PASSWORD=replace-with-a-unique-url-safe-database-password
DATABASE_URL=postgresql://revive_app:replace-with-the-same-url-safe-database-password@postgres:5432/revive_crm?schema=public

MINIO_ROOT_USER=replace-with-a-root-only-minio-access-key
MINIO_ROOT_PASSWORD=replace-with-a-long-root-only-minio-secret
FILE_STORAGE_PROVIDER=s3
S3_ENDPOINT=http://minio:9000
S3_REGION=ap-south-1
S3_BUCKET=revive-private-files
S3_ACCESS_KEY_ID=replace-with-a-separate-application-minio-access-key
S3_SECRET_ACCESS_KEY=replace-with-a-separate-long-application-minio-secret
S3_FORCE_PATH_STYLE=true
S3_KEY_PREFIX=revive-crm
S3_SERVER_SIDE_ENCRYPTION=none
S3_KMS_KEY_ID=
FILE_ENCRYPTION_KEY=replace-with-base64-output-of-openssl-rand-base64-32

JWT_ACCESS_SECRET=replace-with-independent-output-of-openssl-rand-base64-48
JWT_REFRESH_SECRET=replace-with-independent-output-of-openssl-rand-base64-48
INTEGRATION_ENCRYPTION_KEY=replace-with-independent-output-of-openssl-rand-base64-32
FILE_ACCESS_SECRET=replace-with-independent-output-of-openssl-rand-base64-48
GOOGLE_ADS_INGEST_SECRET=replace-with-independent-output-of-openssl-rand-base64-48
META_ADS_INGEST_SECRET=replace-with-independent-output-of-openssl-rand-base64-48
PAYMENT_GATEWAY_SECRET=

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
REFRESH_TOKEN_DAYS=7
REFRESH_TOKEN_COOKIE_NAME=revive_refresh_token
COOKIE_DOMAIN=
FRONTEND_URL=https://crm.reviveskinclinics.in
FRONTEND_URLS=https://crm.reviveskinclinics.in
BACKEND_PUBLIC_URL=https://api.crm.reviveskinclinics.in

META_GRAPH_API_URL=https://graph.facebook.com
META_GRAPH_API_VERSION=v23.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APPOINTMENT_TEMPLATE_NAME=appointment_confirmation
WHATSAPP_APPOINTMENT_TEMPLATE_LANGUAGE=en_US

GOOGLE_ADS_API_URL=https://googleads.googleapis.com
GOOGLE_ADS_API_VERSION=v20
GOOGLE_OAUTH_TOKEN_URL=https://oauth2.googleapis.com/token
GOOGLE_OAUTH_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
INTEGRATION_JOB_POLL_MS=10000
INTEGRATION_WORKER_ID=revive-integration-worker
PROVIDER_REQUEST_TIMEOUT_MS=20000
SHUTDOWN_TIMEOUT_MS=10000
MFA_ISSUER=Revive Clinic CRM
