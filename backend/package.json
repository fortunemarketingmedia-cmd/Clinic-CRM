{
  "name": "revive-crm-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --ignore ../node_modules --ignore node_modules src/server.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "start:worker": "node dist/src/worker.js",
    "lint": "eslint src --ext .ts",
    "test": "tsx --test src/**/*.test.ts",
    "load:smoke": "node scripts/load-smoke.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:medicines": "node scripts/import-medicine-catalog.mjs",
    "catalog:sync": "tsx src/scripts/sync-rate-card.ts",
    "consents:sync": "tsx src/scripts/sync-procedure-consents.ts",
    "data:reset:operational": "node prisma/clear-operational-data.mjs",
    "bootstrap:admin": "node scripts/bootstrap-production-admin.mjs",
    "reset:admin-password": "node scripts/reset-production-password.mjs ADMIN",
    "reset:receptionist-password": "node scripts/reset-production-password.mjs RECEPTIONIST",
    "storage:migrate:s3": "node scripts/transfer-private-files.mjs to-r2 --copy",
    "storage:inventory": "node scripts/transfer-private-files.mjs verify-local",
    "storage:transfer:local": "node scripts/transfer-private-files.mjs to-local",
    "storage:transfer:r2": "node scripts/transfer-private-files.mjs to-r2",
    "test:integration": "tsx --test tests/production-audit.integration.ts tests/api-surface.integration.ts",
    "test:redis": "tsx --test tests/redis.integration.ts",
    "benchmark:audit": "tsx tests/performance-benchmark.ts",
    "audit:setup": "tsx tests/audit-fixtures.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1138.0",
    "@prisma/client": "^6.12.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.22.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.5.0",
    "nodemailer": "^10.3.1",
    "pdfkit": "^0.15.2",
    "prom-client": "^15.1.3",
    "read-excel-file": "^9.3.10",
    "redis": "^6.2.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.13.8",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "eslint": "^9.17.0",
    "prisma": "^6.12.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.1"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
