WHATSAPP_JOB_POLL_MS=5000
WHATSAPP_BROADCAST_APPROVAL_THRESHOLD=100
WHATSAPP_WORKER_ID=revive-whatsapp-worker
META_GRAPH_API_URL=https://graph.facebook.com
