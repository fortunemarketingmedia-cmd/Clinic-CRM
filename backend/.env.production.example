NODE_ENV=production
PORT=4000
TRUST_PROXY_HOPS=1
DATABASE_URL=postgresql://revive_app:replace-with-url-safe-password@postgres:5432/revive_crm?schema=public

JWT_ACCESS_SECRET=generate-an-independent-48-byte-secret
JWT_REFRESH_SECRET=generate-another-independent-48-byte-secret
INTEGRATION_ENCRYPTION_KEY=generate-an-independent-32-byte-encryption-key
FILE_ACCESS_SECRET=generate-an-independent-48-byte-file-signing-secret
GOOGLE_ADS_INGEST_SECRET=generate-an-independent-server-ingest-secret
META_ADS_INGEST_SECRET=generate-another-independent-server-ingest-secret
PAYMENT_GATEWAY_SECRET=

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
REFRESH_TOKEN_DAYS=7
REFRESH_TOKEN_COOKIE_NAME=revive_refresh_token
COOKIE_DOMAIN=
FRONTEND_URL=https://crm.reviveskinclinics.in
FRONTEND_URLS=https://crm.reviveskinclinics.in
BACKEND_PUBLIC_URL=https://api.crm.reviveskinclinics.in

FILE_STORAGE_PROVIDER=s3
S3_ENDPOINT=http://minio:9000
S3_REGION=ap-south-1
S3_BUCKET=revive-private-files
S3_ACCESS_KEY_ID=replace-with-minio-access-key
S3_SECRET_ACCESS_KEY=replace-with-minio-secret-key
S3_FORCE_PATH_STYLE=true
S3_KEY_PREFIX=revive-crm
S3_SERVER_SIDE_ENCRYPTION=none
S3_KMS_KEY_ID=
FILE_ENCRYPTION_KEY=replace-with-base64-output-of-openssl-rand-base64-32

META_GRAPH_API_URL=https://graph.facebook.com
META_GRAPH_API_VERSION=v23.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APPOINTMENT_TEMPLATE_NAME=appointment_confirmation
WHATSAPP_APPOINTMENT_TEMPLATE_LANGUAGE=en_US

GOOGLE_ADS_API_URL=https://googleads.googleapis.com
GOOGLE_ADS_API_VERSION=v20
GOOGLE_OAUTH_TOKEN_URL=https://oauth2.googleapis.com/token
GOOGLE_OAUTH_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
INTEGRATION_JOB_POLL_MS=10000
INTEGRATION_WORKER_ID=revive-integration-worker
PROVIDER_REQUEST_TIMEOUT_MS=20000
SHUTDOWN_TIMEOUT_MS=10000
MFA_ISSUER=Revive Clinic CRM
