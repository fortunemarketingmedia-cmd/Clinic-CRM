model User {
  id                      String                      @id @default(cuid())
  name                    String
  email                   String                      @unique
  passwordHash            String
  role                    Role
  accessLevel             AccessLevel                 @default(RECEPTIONIST)
  status                  UserStatus                  @default(ACTIVE)
  mfaEnabled              Boolean                     @default(false)
  mfaSecretCiphertext     String?
  mfaRecoveryCodes        Json?
  mfaVerifiedAt           DateTime?
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt
  leads                   Lead[]                      @relation("LeadCreatedBy")
  ownedLeads              Lead[]                      @relation("LeadOwner")
  assignedFollowUps       FollowUp[]                  @relation("FollowUpAssignee")
  createdFollowUps        FollowUp[]                  @relation("FollowUpCreator")
  completedFollowUps      FollowUp[]                  @relation("FollowUpCompleter")
  assignedTasks           Task[]                      @relation("TaskAssignee")
  createdTasks            Task[]                      @relation("TaskCreator")
  completedTasks          Task[]                      @relation("TaskCompleter")
  callLogs                CallLog[]
  auditLogs               AuditLog[]
  medicalProfileVersions  MedicalProfileVersion[]
  branchAccess            UserBranch[]
  doctorAppointments      Appointment[]               @relation("AppointmentDoctor")
  therapistAppointments   Appointment[]               @relation("AppointmentTherapist")
  counsellorAppointments  Appointment[]               @relation("AppointmentCounsellor")
  staffSchedules          StaffSchedule[]
  scheduleExceptions      ScheduleException[]
  preferredWaitlists      WaitlistEntry[]             @relation("WaitlistPreferredDoctor")
  assignedWaitlists       WaitlistEntry[]             @relation("WaitlistAssignee")
  timelineEvents          TimelineEvent[]
  assignedPatients        Patient[]                   @relation("PatientAssignedDoctor")
  doctorEncounters        ClinicalEncounter[]         @relation("EncounterDoctor")
  therapistEncounters     ClinicalEncounter[]         @relation("EncounterTherapist")
  signedEncounters        ClinicalEncounter[]         @relation("EncounterSigner")
  encounterAddendums      ClinicalEncounterAddendum[]
  doctorTreatmentPlans    TreatmentPlan[]             @relation("TreatmentPlanDoctor")
  therapistTreatmentPlans TreatmentPlan[]             @relation("TreatmentPlanTherapist")
  treatmentPlanItems      TreatmentPlanItem[]         @relation("TreatmentPlanItemPractitioner")
  procedureSessions       ProcedureSession[]          @relation("ProcedurePractitioner")
  assistedProcedures      ProcedureSession[]          @relation("ProcedureAssistant")
  doctorPrescriptions     Prescription[]              @relation("PrescriptionDoctor")
  signedPrescriptions     Prescription[]              @relation("PrescriptionSigner")
  createdFormTemplates    FormTemplate[]              @relation("FormTemplateCreator")
  submittedForms          FormSubmission[]            @relation("FormSubmitter")
  createdConsentTemplates ConsentTemplate[]           @relation("ConsentTemplateCreator")
  witnessedConsents       ConsentRecord[]             @relation("ConsentWitness")
  uploadedPatientFiles    PatientFile[]               @relation("PatientFileUploader")
  createdEstimates        Estimate[]                  @relation("EstimateCreator")
  createdInvoices         Invoice[]                   @relation("InvoiceCreator")
  collectedPayments       Payment[]                   @relation("PaymentCollector")
  reversedPayments        Payment[]                   @relation("PaymentReverser")
  requestedRefunds        Refund[]                    @relation("RefundRequester")
  approvedRefunds         Refund[]                    @relation("RefundApprover")
  issuedCreditNotes       CreditNote[]                @relation("CreditNoteIssuer")
  requestedDiscounts      DiscountApproval[]          @relation("DiscountRequester")
  approvedDiscounts       DiscountApproval[]          @relation("DiscountApprover")
  assignedCollections     Invoice[]                   @relation("InvoiceCollectionOwner")
  submittedCashClosings   DailyCashClosing[]          @relation("CashClosingSubmitter")
  approvedCashClosings    DailyCashClosing[]          @relation("CashClosingApprover")
  packageLedgerEntries    PackageSessionLedger[]      @relation("PackageLedgerActor")
  inventoryMovements      StockMovement[]             @relation("StockMovementActor")
  createdPurchaseOrders   PurchaseOrder[]             @relation("PurchaseOrderCreator")
  approvedPurchaseOrders  PurchaseOrder[]             @relation("PurchaseOrderApprover")
  postedGoodsReceipts     GoodsReceipt[]              @relation("GoodsReceiptPoster")
  createdStockTransfers   StockTransfer[]             @relation("StockTransferCreator")
  approvedStockTransfers  StockTransfer[]             @relation("StockTransferApprover")
  shippedStockTransfers   StockTransfer[]             @relation("StockTransferShipper")
  receivedStockTransfers  StockTransfer[]             @relation("StockTransferReceiver")
  confirmedConsumptions   ProcedureConsumption[]      @relation("ProcedureConsumptionConfirmer")
  inventoryAdjustments    StockAdjustment[]           @relation("StockAdjustmentActor")
  assignedWaConversations WhatsAppConversation[]      @relation("WhatsAppConversationAssignee")
  createdWaMessages       WhatsAppMessage[]           @relation("WhatsAppMessageCreator")
  createdWaTemplates      WhatsAppTemplate[]          @relation("WhatsAppTemplateCreator")
  createdWaBroadcasts     WhatsAppBroadcast[]         @relation("WhatsAppBroadcastCreator")
  approvedWaBroadcasts    WhatsAppBroadcast[]         @relation("WhatsAppBroadcastApprover")
  refreshTokens           RefreshToken[]
  integrationConnections  IntegrationConnection[]     @relation("IntegrationConnectionCreator")
  createdCampaigns        MarketingCampaign[]         @relation("MarketingCampaignCreator")
  createdAutomations      AutomationDefinition[]      @relation("AutomationCreator")
  automationExecutions    AutomationExecution[]       @relation("AutomationExecutionActor")
  exportLogs              ExportLog[]
  loginEvents             LoginEvent[]

  @@index([accessLevel, status])
}

model UserBranch {
  userId    String
  branchId  String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([userId, branchId])
  @@index([branchId])
}

model RefreshToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  userAgent  String?
  ipAddress  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  lastSeenAt DateTime  @default(now())
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Branch {
  id                     String                  @id @default(cuid())
  name                   String                  @unique
  address                String
  phone                  String
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  leads                  Lead[]
  appointments           Appointment[]
  patients               Patient[]
  invoices               Invoice[]
  packages               TreatmentPackage[]
  adLeads                AdLead[]
  preferredByPeople      Person[]                @relation("PreferredBranch")
  userAccess             UserBranch[]
  followUps              FollowUp[]
  tasks                  Task[]
  callLogs               CallLog[]
  auditLogs              AuditLog[]
  clinicServices         ClinicService[]
  clinicResources        ClinicResource[]
  staffSchedules         StaffSchedule[]
  scheduleExceptions     ScheduleException[]
  waitlistEntries        WaitlistEntry[]
  scoringRules           LeadScoringRule[]
  clinicalEncounters     ClinicalEncounter[]
  treatmentPlans         TreatmentPlan[]
  procedureSessions      ProcedureSession[]
  clinicalTemplates      ClinicalTemplate[]
  formTemplates          FormTemplate[]
  consentTemplates       ConsentTemplate[]
  estimates              Estimate[]
  payments               Payment[]
  refunds                Refund[]
  creditNotes            CreditNote[]
  packageMasters         PackageMaster[]
  cashClosings           DailyCashClosing[]
  branchStocks           BranchStock[]
  inventoryBatches       InventoryBatch[]
  stockMovements         StockMovement[]         @relation("StockMovementBranch")
  purchaseOrders         PurchaseOrder[]
  goodsReceipts          GoodsReceipt[]
  outgoingTransfers      StockTransfer[]         @relation("StockTransferFromBranch")
  incomingTransfers      StockTransfer[]         @relation("StockTransferToBranch")
  procedureConsumptions  ProcedureConsumption[]
  inventoryAdjustments   StockAdjustment[]
  inventoryAlerts        InventoryAlert[]
  whatsappPhoneNumbers   WhatsAppPhoneNumber[]
  whatsappConversations  WhatsAppConversation[]
  whatsappTemplates      WhatsAppTemplate[]
  whatsappBroadcasts     WhatsAppBroadcast[]
  whatsappAutomations    WhatsAppAutomation[]
  durableJobs            DurableJob[]
  integrationConnections IntegrationConnection[]
  marketingCampaigns     MarketingCampaign[]
  adPerformance          AdPerformanceDaily[]
  attributionTouches     AttributionTouch[]
  automationDefinitions  AutomationDefinition[]
  automationExecutions   AutomationExecution[]
}

model Person {
  id                             String                       @id @default(cuid())
  fullName                       String
  primaryMobile                  String
  normalizedMobile               String
  alternateMobile                String?
  normalizedAlternateMobile      String?
  email                          String?
  normalizedEmail                String?
  dateOfBirth                    DateTime?
  sex                            Sex?
  address                        String?
  city                           String?
  state                          String?
  pinCode                        String?
  emergencyContactName           String?
  emergencyContactMobile         String?
  guardianName                   String?
  guardianMobile                 String?
  guardianRelationship           String?
  preferredLanguage              String?
  preferredChannel               PreferredChannel?
  preferredBranchId              String?
  marketingConsent               Boolean                      @default(false)
  transactionalConsent           Boolean                      @default(false)
  appointmentNotificationConsent Boolean                      @default(false)
  dataProcessingConsent          Boolean                      @default(false)
  duplicateConfidence            Decimal?                     @db.Decimal(5, 2)
  recordStatus                   PersonRecordStatus           @default(ACTIVE)
  mergedIntoId                   String?
  createdAt                      DateTime                     @default(now())
  updatedAt                      DateTime                     @updatedAt
  preferredBranch                Branch?                      @relation("PreferredBranch", fields: [preferredBranchId], references: [id])
  mergedInto                     Person?                      @relation("PersonMerge", fields: [mergedIntoId], references: [id])
  mergedRecords                  Person[]                     @relation("PersonMerge")
  leads                          Lead[]
  patient                        Patient?
  timelineEvents                 TimelineEvent[]
  followUps                      FollowUp[]
  tasks                          Task[]
  callLogs                       CallLog[]
  waitlistEntries                WaitlistEntry[]
  whatsappConversations          WhatsAppConversation[]
  whatsappOptIns                 WhatsAppOptIn[]
  whatsappBroadcastRecipients    WhatsAppBroadcastRecipient[]
  attributionTouches             AttributionTouch[]
  conversionEvents               ConversionEvent[]

  @@index([normalizedMobile])
  @@index([normalizedEmail])
  @@index([normalizedAlternateMobile])
  @@index([recordStatus])
  @@index([preferredBranchId])
}

model Lead {
  id                          String                       @id @default(cuid())
  qrToken                     String                       @unique
  name                        String
  mobile                      String
  email                       String?
  address                     String?
  source                      EnquirySource
  status                      LeadStatus                   @default(NEW)
  priority                    LeadPriority                 @default(MEDIUM)
  nextFollowupAt              DateTime?
  lastContactedAt             DateTime?
  followupNotes               String?
  interestedTreatment         String?
  appointmentType             AppointmentType              @default(CLINIC_VISIT)
  appointmentAt               DateTime?
  branchId                    String
  createdById                 String
  personId                    String?
  ownerId                     String?
  nextAction                  String?
  nextActionDueAt             DateTime?
  qualificationStatus         String?
  qualificationNotes          String?
  leadScore                   Int                          @default(0)
  scoreCategory               LeadScoreCategory            @default(COLD)
  lostReason                  String?
  lostNotes                   String?
  disqualificationReason      String?
  convertedAt                 DateTime?
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  branch                      Branch                       @relation(fields: [branchId], references: [id])
  createdBy                   User                         @relation("LeadCreatedBy", fields: [createdById], references: [id])
