  status                   IntegrationStatus         @default(DISCONNECTED)
  accessTokenCiphertext    String?
  refreshTokenCiphertext   String?
  clientSecretCiphertext   String?
  developerTokenCiphertext String?
  appSecretCiphertext      String?
  verifyTokenCiphertext    String?
  tokenExpiresAt           DateTime?
  scopes                   Json?
  configuration            Json?
  lastSyncAt               DateTime?
  lastSuccessAt            DateTime?
  lastFailureAt            DateTime?
  lastFailureReason        String?
  webhookVerifiedAt        DateTime?
  consecutiveFailures      Int                       @default(0)
  createdById              String
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  branch                   Branch?                   @relation(fields: [branchId], references: [id])
  createdBy                User                      @relation("IntegrationConnectionCreator", fields: [createdById], references: [id])
  fieldMappings            IntegrationFieldMapping[]
  events                   IntegrationEvent[]
  syncRuns                 IntegrationSyncRun[]
  campaigns                MarketingCampaign[]
  conversionEvents         ConversionEvent[]

  @@index([provider, status])
  @@index([externalAccountId])
  @@index([branchId, provider])
}

model IntegrationFieldMapping {
  id               String                @id @default(cuid())
  connectionId     String
  externalFormId   String
  externalFormName String?
  branchId         String?
  ownerId          String?
  mapping          Json
  defaults         Json?
  active           Boolean               @default(true)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  connection       IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, externalFormId])
  @@index([externalFormId, active])
}

model IntegrationEvent {
  id                 String                 @id @default(cuid())
  connectionId       String
  providerEventId    String?
  eventHash          String                 @unique
  eventType          String
  signature          String?
  signatureVerified  Boolean                @default(false)
  status             IntegrationEventStatus @default(RECEIVED)
  payload            Json
  processingAttempts Int                    @default(0)
  leadId             String?
  failureReason      String?
  receivedAt         DateTime               @default(now())
  processedAt        DateTime?
  updatedAt          DateTime               @updatedAt
  connection         IntegrationConnection  @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId, status, receivedAt])
  @@index([providerEventId])
}

model IntegrationSyncRun {
  id             String                @id @default(cuid())
  connectionId   String
  type           String
  status         IntegrationSyncStatus @default(QUEUED)
  cursor         String?
  dateFrom       DateTime?
  dateTo         DateTime?
  expectedCount  Int?
  retrievedCount Int                   @default(0)
  createdCount   Int                   @default(0)
  duplicateCount Int                   @default(0)
  failedCount    Int                   @default(0)
  missingCount   Int                   @default(0)
  details        Json?
  errorMessage   String?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime              @default(now())
  connection     IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId, status, createdAt])
}

model MarketingCampaign {
  id                 String                  @id @default(cuid())
  connectionId       String?
  externalCampaignId String?
  platform           AdPlatform
  name               String
  objective          String?
  status             MarketingCampaignStatus @default(DRAFT)
  branchId           String?
  ownerId            String?
  budget             Decimal?                @db.Decimal(14, 2)
  startDate          DateTime?
  endDate            DateTime?
  audience           Json?
  createdById        String
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  connection         IntegrationConnection?  @relation(fields: [connectionId], references: [id])
  branch             Branch?                 @relation(fields: [branchId], references: [id])
  createdBy          User                    @relation("MarketingCampaignCreator", fields: [createdById], references: [id])
  dailyPerformance   AdPerformanceDaily[]
  attributionTouches AttributionTouch[]

  @@unique([connectionId, externalCampaignId])
  @@index([platform, status, startDate])
  @@index([branchId, status])
}

model AdPerformanceDaily {
  id                  String            @id @default(cuid())
  campaignId          String
  branchId            String?
  date                DateTime          @db.Date
  externalAdSetId     String?
  adSetName           String?
  externalAdId        String?
  adName              String?
  device              String?
  network             String?
  spend               Decimal           @default(0) @db.Decimal(14, 2)
  impressions         Int               @default(0)
  reach               Int               @default(0)
  clicks              Int               @default(0)
  landingPageViews    Int               @default(0)
  platformConversions Decimal           @default(0) @db.Decimal(12, 2)
  leads               Int               @default(0)
  rawMetrics          Json?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  campaign            MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  branch              Branch?           @relation(fields: [branchId], references: [id])

  @@unique([campaignId, date, externalAdSetId, externalAdId, device, network])
  @@index([branchId, date])
  @@index([date])
}

model AttributionTouch {
  id             String             @id @default(cuid())
  personId       String?
  leadId         String?
  branchId       String?
  campaignId     String?
  platform       AdPlatform?
  touchType      String
  source         String?
  medium         String?
  campaignName   String?
  content        String?
  term           String?
  landingPage    String?
  gclid          String?
  gbraid         String?
  wbraid         String?
  fbclid         String?
  externalLeadId String?
  occurredAt     DateTime           @default(now())
  metadata       Json?
  createdAt      DateTime           @default(now())
  person         Person?            @relation(fields: [personId], references: [id])
  lead           Lead?              @relation(fields: [leadId], references: [id])
  branch         Branch?            @relation(fields: [branchId], references: [id])
  campaign       MarketingCampaign? @relation(fields: [campaignId], references: [id])

  @@index([leadId, occurredAt])
  @@index([personId, occurredAt])
  @@index([gclid])
  @@index([externalLeadId])
  @@index([branchId, occurredAt])
  @@index([campaignId, occurredAt])
}

model ConversionEvent {
  id               String                 @id @default(cuid())
  connectionId     String
  platform         ConversionPlatform
  eventType        String
  eventId          String                 @unique
  idempotencyKey   String                 @unique
  personId         String?
  leadId           String?
  campaignId       String?
  eventTime        DateTime
  conversionAction String?
  transactionId    String?
  value            Decimal?               @db.Decimal(14, 2)
  currency         String                 @default("INR")
  gclid            String?
  gbraid           String?
  wbraid           String?
  consentGranted   Boolean                @default(false)
  status           ConversionUploadStatus @default(QUEUED)
  retryCount       Int                    @default(0)
  providerResponse Json?
  failureReason    String?
  nextAttemptAt    DateTime               @default(now())
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  connection       IntegrationConnection  @relation(fields: [connectionId], references: [id])
  person           Person?                @relation(fields: [personId], references: [id])
  lead             Lead?                  @relation(fields: [leadId], references: [id])

  @@index([connectionId, status, nextAttemptAt])
  @@index([leadId, eventTime])
}

model AutomationDefinition {
  id             String                @id @default(cuid())
  name           String
  description    String?
  trigger        AutomationTrigger
  branchId       String?
  conditions     Json?
  workflow       Json
  stopConditions Json?
  active         Boolean               @default(false)
  testMode       Boolean               @default(true)
  version        Int                   @default(1)
  createdById    String
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  branch         Branch?               @relation(fields: [branchId], references: [id])
  createdBy      User                  @relation("AutomationCreator", fields: [createdById], references: [id])
  executions     AutomationExecution[]

  @@index([trigger, active])
  @@index([branchId, active])
}

model AutomationExecution {
  id             String                    @id @default(cuid())
  automationId   String
  branchId       String?
  leadId         String?
  referenceType  String
  referenceId    String
  triggerPayload Json?
  status         AutomationExecutionStatus @default(QUEUED)
  currentStep    Int                       @default(0)
  executionLog   Json?
  retryCount     Int                       @default(0)
  nextRunAt      DateTime                  @default(now())
  errorMessage   String?
  actorId        String?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  automation     AutomationDefinition      @relation(fields: [automationId], references: [id], onDelete: Cascade)
  branch         Branch?                   @relation(fields: [branchId], references: [id])
  lead           Lead?                     @relation(fields: [leadId], references: [id])
  actor          User?                     @relation("AutomationExecutionActor", fields: [actorId], references: [id])

  @@unique([automationId, referenceType, referenceId, createdAt])
  @@index([status, nextRunAt])
  @@index([leadId, createdAt])
}

model LoginEvent {
  id        String   @id @default(cuid())
  userId    String?
  email     String
  success   Boolean
  reason    String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email, createdAt])
  @@index([userId, createdAt])
  @@index([success, createdAt])
  @@index([success, createdAt, ipAddress])
}

model ExportLog {
  id            String       @id @default(cuid())
  userId        String
  branchId      String?
  resourceType  String
  format        String
  filters       Json?
  rowCount      Int?
  status        ExportStatus @default(REQUESTED)
  purpose       String
  ipAddress     String?
  correlationId String
  completedAt   DateTime?
  failureReason String?
  createdAt     DateTime     @default(now())
  user          User         @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([resourceType, createdAt])
}

model BackupVerification {
  id                 String    @id @default(cuid())
  backupReference    String
  environment        String
  status             String
  checksum           String?
  restoreStartedAt   DateTime?
  restoreCompletedAt DateTime?
  verifiedBy         String?
  evidence           Json?
  failureReason      String?
  createdAt          DateTime  @default(now())

  @@index([status, createdAt])
}

model ClinicSettings {
  id                    String   @id @default(cuid())
  clinicName            String   @default("Revive Clinic")
  clinicEmail           String?
  clinicLogoUrl         String?
  gstNumber             String?
  invoicePrefix         String   @default("REV")
  gstPercent            Decimal  @default(0) @db.Decimal(5, 2)
  businessAddress       String?
  businessPhone         String?
  legalName             String?
  website               String?
  registrationNumber    String?
  city                  String?
  state                 String?
  postalCode            String?
  openingHours          String?
  timezone              String?  @default("Asia/Kolkata")
  invoiceTerms          String?
  invoiceSignature      String?
  invoiceFooter         String?
  paymentInstructions   String?
  qrRegistrationEnabled Boolean  @default(true)
  patientFormConfig     Json?
  whatsappPhoneId       String?
  whatsappAccessToken   String?
  appointmentTemplate   String?
  reminderTemplate      String?
  invoiceTemplate       String?
  followupTemplate      String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}
